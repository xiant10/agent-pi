{
	"name": "agent-pi",
	"version": "0.2.0",
	"description": "Reusable multi-user agent harness on pi-durable: Streamable HTTP, JWT auth, steering, skills with dynamic MCP tool loading, voice output, and a plugin system for business logic",
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./plugins": "./src/plugins/library/index.ts",
		"./testing": "./src/testing.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsc --noEmit -p ../..",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-mcp": "1.4.0",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "0.223.0",
		"@opentelemetry/resources": "2.12.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"typebox": "1.3.27"
	}
}
