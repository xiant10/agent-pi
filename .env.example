# The agent to run, on the shared runtime. `npm start` sets this to the assistant.
# AGENT_CONFIG=apps/assistant/config/agent.json

# Auth: "static" (for development/local testing) or "jwt" (production).
AUTH_KIND=static
AGENT_TOKENS={"dev-token":"dev-user"}

# Production JWT configuration (set AUTH_KIND=jwt to enable):
# AUTH_KIND=jwt
# JWT_ALGORITHMS=RS256,ES256
# JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# JWT_ISSUER=https://idp.example.com/
# JWT_AUDIENCE=agent-pi       # with t10-auth: t10,agent-pi. People's tokens carry t10, a voice agent's grants agent-pi
# JWT_REQUIRED_SCOPES=agent:use
# JWT_TENANT_CLAIM=tid
# JWT_HMAC_SECRET=            # only with JWT_ALGORITHMS=HS256

# t10 auth service, with AUTH_KIND=jwt. JWT_AUDIENCE must then be t10,agent-pi:
# people arrive with aud=t10 and LiveKit callers with aud=agent-pi. Setting
# AUTH_URL turns on agent grants: a run gets its own tokens, keeps working while
# the user is offline, and resumes after a restart. Servers with auth: "grant"
# need it. The secret comes from `authctl service-add --name agent-pi`.
# AUTH_URL=http://localhost:8081
# AUTH_CLIENT_ID=agent-pi
# AUTH_CLIENT_SECRET=
# GRANT_ACTIONS=agent:use
# GRANT_AUDIENCES=agent-pi

# Models: one OpenAI-compatible gateway serving a fast model (voice) and a stronger one (chat, expert).
# When running in Docker, use http://host.docker.internal:7200/v1 to reach a host-bound gateway/vLLM/Ollama.
LLM_BASE_URL=http://host.docker.internal:7200/v1
LLM_API_KEY=sk-default
LLM_API=chat-completions
FAST_MODEL_ID=codex-llm
SMART_MODEL_ID=codex-llm
SMART_MODEL_REASONING=false

# Browser origins allowed to call the agent (comma-separated); * allows all, empty refuses all browser origins.
ALLOWED_ORIGINS=*
LOG_LEVEL=info

# OTLP/HTTP collector to export traces to, as a URL (unlike the Go services' gRPC host:port). Leave unset to disable
# export; a client's traceparent still reaches the model gateway. The t10 stack publishes this at localhost:4319, or
# http://host.docker.internal:4319 from a container.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
# Traces name the service after the config's `agent`; this overrides it.
# OTEL_SERVICE_NAME=assistant


# Business settings read by the assistant's config.
BUSINESS_TIME_ZONE=Asia/Shanghai
