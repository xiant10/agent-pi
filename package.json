{
	"name": "agent-pi-workspace",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"start": "AGENT_CONFIG=apps/assistant/config/agent.json node --disable-warning=ExperimentalWarning packages/agent-pi/src/main.ts",
		"check": "tsc --noEmit",
		"smoke": "node --disable-warning=ExperimentalWarning apps/assistant/scripts/smoke.ts",
		"mock:compare": "bash scripts/mock/compare.sh",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"license": "Apache-2.0"
}
